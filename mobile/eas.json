{
  "cli": {
    "version": ">=27.11.0",
    "appVersionSource": "remote"
  },
  "build": {
    "demo": {
      "distribution": "internal",
      "environment": "preview",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_ADAPT_MOCK_ENABLED": "false",
        "EXPO_PUBLIC_SOURCED_DEMO": "true"
      }
    },
    "main-qa": {
      "extends": "demo",
      "channel": "main-qa",
      "autoIncrement": true
    },
    "pr-device": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "android": { "buildType": "apk" },
      "env": { "APP_VARIANT": "pr-preview" }
    },
    "main": {
      "extends": "demo",
      "environment": "production",
      "channel": "main",
      "env": { "EXPO_PUBLIC_API_URL": "https://dangdao2007.pythonanywhere.com" },
      "autoIncrement": true
    }
  }
}
