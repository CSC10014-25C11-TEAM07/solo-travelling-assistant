      ]
    },
    "P005": {
      "scope": "120 phút tham quan toàn khu. Dùng giao của khung đặt vé hằng ngày và lịch tuần có nghỉ trưa. Lịch Android chỉ dùng VISIT.",
      "sources": [
        "https://baotanglamdong.com.vn/tickets",
        "https://visitlamdong.vn/vi/baotangld",
        "https://www.openstreetmap.org/node/1152350875"
      ]
    },
    "P006": {
      "scope": "Chỉ khu ngồi trong nhà tại 200 Nguyễn Công Trứ. Lịch từng thứ khớp giờ của quán. 60 phút là ngân sách tham quan.",
      "sources": [
        "https://laviet.coffee/tu-chung-toi/",
        "https://visitlamdong.vn/vi/lavietcoffeedl",
        "https://langthangdalat.com/en/places/la-viet-coffee/"
      ]
    },
    "P008": {
      "scope": "Tham quan cả khu Dinh III, 60 phút. Dùng các khung theo tuần có nghỉ trưa.",
      "sources": [
        "https://visitlamdong.vn/vi/dinhiii",
        "https://www.openstreetmap.org/node/5274759821"
      ]
    },
    "P009": {
      "sources": [
        "https://crazyhouse.vn/tham-quan"
      ],
      "scope": "Lịch tuần và thời lượng tham quan đã xác minh trong bộ dữ liệu chung. Tách riêng với mốc qua đêm trên đường Huỳnh Thúc Kháng."
    },
    "P010": {
      "scope": "Quán và sân vườn tại 59 Nguyễn Trãi. Điểm nghỉ có ghế ngồi; 60 phút là ngân sách.",
      "sources": [
        "https://visitlamdong.vn/vi/stillcafe",
        "https://www.openstreetmap.org/node/6152524285",
        "https://stillcafe.org/still-cafe-da-lat/"
      ]
    },
    "P011": {
      "scope": "63Bis đường Ba Tháng Hai, trong nhà và ngoài trời, phục vụ đồ ăn và cà phê. Dùng giờ đóng sớm hơn giữa hai lịch tuần; thời lượng là ngân sách.",
      "sources": [
        "https://www.ancafeglobal.com/",
        "https://langthangdalat.com/dia-diem/an-cafe/",
        "https://www.openstreetmap.org/node/4206500720",
        "https://vnguide.vn/restaurant/an-cafe"
      ]
    },
    "SAIGON-PARIS": {
      "scope": "Mốc tính giờ trên đường công cộng. 05:00–19:00 là khung xuất phát/về của sản phẩm, không phải giờ đỗ xe hoặc giờ vào bưu điện. Khung thời gian lập lịch mở rộng đến 20:00.",
      "sources": [
        "https://hello.hochiminhcity.gov.vn/vi/discover/buu-dien-thanh-pho",
        "https://www.openstreetmap.org/way/465309061"
      ]
    },
    "DALAT-HTK": {
      "scope": "Mốc tính giờ trên đường Huỳnh Thúc Kháng gần số 03. Giờ kế hoạch chỉ áp dụng cho mốc ngoài đường. Crazy House là chỗ nghỉ gợi ý, người dùng tự xác nhận phòng và giờ nhận/trả. Khung thời gian lập lịch mở rộng đến 20:00.",
      "sources": [
        "https://crazyhouse.vn/chinh-sach",
        "https://www.openstreetmap.org/way/99661201"
      ]
    },
    "BAOLOC-294A": {
      "scope": "Dừng nghỉ tại nhà hàng; giờ thứ Hai đến Chủ nhật lấy phần giao giữa trang liên hệ và chân trang. Điểm định tuyến trên QL20/Trần Phú phía nhà hàng; không xác nhận cổng hoặc bãi đậu.",
      "sources": [
        "https://www.tamchaucenter.com/lien-he",
        "https://www.tamchaucenter.com/",
        "https://www.openstreetmap.org/node/4660437689",
        "https://www.openstreetmap.org/way/246261510",
        "https://sotayvang.com/nha-hang-tam-chau-bao-loc-phuong-1/"
      ]
    },
    "CTHAO-LANGA": {
      "scope": "Trạm tại Tổ 3, Ấp 94, La Ngà. Trang của đơn vị nêu hoạt động 24/24 hằng ngày. Tọa độ 11.1079747,107.2287916 theo liên kết bản đồ từ trang đơn vị, chưa khẳng định vị trí cổng và bãi đỗ.",
      "sources": [
        "https://tramdungchancanhthaonguyen.com/",
        "https://www.tramdungchancanhthaonguyen.com/gioi-thieu"
      ]
    },
    "CALI-417": {
      "scope": "Quán tại 417 Quốc lộ 20, Liên Nghĩa, Đức Trọng. Dùng 06:30–22:00 là giao của hai bảng giờ từng ngày. Tọa độ 11.744463,108.37583 từ dữ liệu vị trí của trang Wanderlog; chưa xác minh vị trí cổng và bãi đỗ.",
