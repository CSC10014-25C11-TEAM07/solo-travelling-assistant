    "DALAT-HTK": {
      "scope": "Mốc tính giờ trên đường Huỳnh Thúc Kháng gần số 03. Giờ kế hoạch chỉ áp dụng cho mốc ngoài đường. Crazy House là chỗ nghỉ gợi ý, người dùng tự xác nhận phòng và giờ nhận/trả.",
      "sources": [
        "https://crazyhouse.vn/chinh-sach",
